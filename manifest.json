{
  "name": "mochijsnative",
  "version": "0.4.0",
  "layer": "package",
  "description": "Native-first meta-programming bridge for MochiBerry (JS to engine context/value/symbol APIs).",
  "status": "verified",
  "entry": "./mochi_modules/mochijsnative/script/index.js",
  "layers": {
    "js": "./mochi_modules/mochijsnative/script/index.js",
    "native": "./mochi_modules/mochijsnative/manifest.json",
    "compat": "./node_modules/manifest.json"
  },
  "abi_version": "MBC1",
  "native_entry": "mbjs_init_module",
  "runtime_exports": [],
  "build": {
    "engine_include": "$ENGINE_INC",
    "mochi_include": "$MOCHI_INC",
    "dynalib_dir": "$DYNALIB_DIR",
    "lib_dir": "./mochi_modules/mochijsnative/lib",
    "output": "./mochi_modules/mochijsnative/lib/mochijsnative_x86_64.dll"
  }
}
